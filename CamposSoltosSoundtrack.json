                    "url": "./breeze/packs/soundtrack/music/Asylum.mp4",
                    "volume": 0.7
                }
            }
        },
        {
            "if": "location 'prison'",
            "do": {
                "music": {
                    "url": "./breeze/packs/soundtrack/music/Prison.mp4",
                    "volume": 0.7
                }
            }
        },
        {
            "if": "location 'underground'",
            "do": {
                "if": "passage has 'Underground'",
                "do": {
                    "music": {
                        "url": "./breeze/packs/soundtrack/music/UndergroundBrothel.mp4"
                    }
                }
            }
        },
        {
            "if": "location 'landfill'",
            "do": {
                "music": {
                    "url": "#Landfill"
                }
            }
        },
        {
            "if": "location 'arcade' and !outside",
            "do": [
                {
                    "if": "passage has 'Tenyclus'",
                    "do": {
                        "music": {
                            "url": "#Tenyclus"
                        }
                    }
                },
                {
                    "if": "(dayState 'day' or dayState 'dusk')",
                    "do": {
                        "music": {
                            "url": "#Arcade"
                        }
                    }
                }
            ]
        },
        {
            "if": "location 'brothel'",
            "do": {
                "music": {
                    "url": "#Brothel"
                }
            }
        },
        {
            "if": "location 'strip_club' and clock > 18:00",
            "do": [
                {
                    "if": "text has 'No entry' or passage 'Strip Club Proposition'",
                    "do": {
                        "music": {
                            "url": "#Club",
                            "volume": 0.1,
                            "fadein": 1500
                        }
                    }
                },
                {
                    "do": {
                        "music": {
                            "url": "#Club",
                            "volume": 0.3,
                            "fadein": 2500
                        }
                    }
                }
            ]
        },
        {
            "if": "passage has 'Adult Shop'",
            "do": {
                "music": {
                    "url": "#AdultShop"
                }
            }
        },
        {
            "if": "location 'forest'",
            "do": {
                "music": {
                    "url": "#Forest",
                    "volume": 1
                }
            }
        },
        {
            "if": "(location has 'school' or location 'pool') and (time.hour >= 7 and time.hour <= 17)",
            "do": [
                {
                    "if": "time.weekDayName 'Friday' and clock < 14:59",
                    "do": {
                        "music": {
                            "url": "#Classroom"
                        }
                    }
                },
                {
                    "do": {
                        "music": {
                            "url": "#SchoolHall",
                            "volume": 1
                        }
                    }
                }
            ]
        }
    ]
}